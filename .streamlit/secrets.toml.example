# Example Secrets for Streamlit Community Cloud
# Paste these directly into your Streamlit Cloud App Settings -> Secrets

# Model & Search API Keys
MODEL = "openai/gpt-oss-120b"
GROQ_API_KEY = "gsk_your_groq_api_key_here"
SERPER_API_KEY = "your_serper_api_key_here"
AUTH_COOKIE_KEY = "generate_a_random_secure_key_here_for_cookies"
ENABLE_AUTH = true

# Authentication Credentials (stored in encrypted secrets, no auth.yaml required!)
[credentials.usernames.admin]
email = "admin@example.com"
failed_login_attempts = 0
first_name = "Admin"
last_name = "User"
logged_in = false
password = "$2b$12$4dWgGRlmRz3XTSCu1TGUquGwp98ymwKqF3dHizVPdIyHdjdALIVdi" # hash for adminpassword123
roles = ["admin"]

[credentials.usernames.analyst]
email = "analyst@example.com"
failed_login_attempts = 0
first_name = "Market"
last_name = "Analyst"
logged_in = false
password = "$2b$12$oAKPP8FBiczkb3NAS6LUFOlWbz8UNTvPpGNkBZFVcVWiv0QbkSMqm" # hash for analystpassword123
roles = ["analyst"]

[cookie]
name = "market_research_auth_cookie"
expiry_days = 30
